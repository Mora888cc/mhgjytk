        UDim2.new(0,140,0, #options*26+4),
        UDim2.new(0,0,0,0),
        PAL.PANEL, 20)
    MakeCorner(dropFrame, 6)
    MakeStroke(dropFrame, PAL.BORDER, 1)
    dropFrame.Visible = false

    local dLayout = Instance.new("UIListLayout")
    dLayout.SortOrder = Enum.SortOrder.LayoutOrder
    dLayout.Padding   = UDim.new(0,2)
    dLayout.Parent    = dropFrame
    local dPad = Instance.new("UIPadding")
    dPad.PaddingTop = UDim.new(0,2); dPad.PaddingLeft = UDim.new(0,2); dPad.PaddingRight = UDim.new(0,2)
    dPad.Parent = dropFrame

    for _, opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Size              = UDim2.new(1,0,0,24)
        ob.Text              = opt
        ob.TextSize          = 12
        ob.Font              = Enum.Font.Gotham
        ob.TextColor3        = PAL.TEXT
        ob.BackgroundColor3  = (opt == CFG[cfgKey]) and PAL.ACCENT or PAL.SLIDER_BG
        ob.BorderSizePixel   = 0
        ob.ZIndex            = 22
        ob.Parent            = dropFrame
        MakeCorner(ob, 4)
        ob.MouseButton1Click:Connect(function()
            CFG[cfgKey] = opt
            dd.Text     = opt
            dropFrame.Visible = false
            for _, b in ipairs(dropFrame:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = (b.Text == opt) and PAL.ACCENT or PAL.SLIDER_BG
                end
            end
            if callback then callback(opt) end
            SaveCFG()
        end)
    end

    local open = false
    dd.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local abs = dd.AbsolutePosition
            local sz  = dd.AbsoluteSize
            dropFrame.Position = UDim2.new(0, abs.X, 0, abs.Y + sz.Y + 2)
        end
        dropFrame.Visible = open
    end)

    -- close on outside click
    UserInputService.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and open then
            local mpos = UserInputService:GetMouseLocation()
            local abs  = dropFrame.AbsolutePosition
            local sz   = dropFrame.AbsoluteSize
            if mpos.X < abs.X or mpos.X > abs.X+sz.X or mpos.Y < abs.Y or mpos.Y > abs.Y+sz.Y then
                open = false; dropFrame.Visible = false
            end
        end
    end)
    return row
end

