--  ANTI AIM LOGIC
-- ══════════════════════════════════════════════════════════════
local spinAngle = 0
local function ApplyAntiAim()
    if not CFG.AA_Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local camCF = Camera.CFrame
    local pitchAngle = 0
    local yawAngle   = 0

    if CFG.AA_Pitch == "Down"  then pitchAngle = -89
    elseif CFG.AA_Pitch == "Up"   then pitchAngle =  89
    end

    if CFG.AA_Yaw == "Backwards" then yawAngle = 180
    elseif CFG.AA_Yaw == "Sideways" then yawAngle = 90
    end
    if CFG.AA_Spin  then spinAngle = (spinAngle + 10) % 360; yawAngle = spinAngle end
    if CFG.AA_Jitter then yawAngle = yawAngle + math.random(-25,25) end
    if CFG.AA_Random then pitchAngle = math.random(-89,89); yawAngle = math.random(0,360) end

    local cf = CFrame.new(hrp.Position)
        * CFrame.Angles(0, math.rad(yawAngle), 0)
        * CFrame.Angles(math.rad(pitchAngle), 0, 0)
    hrp.CFrame = cf
end

