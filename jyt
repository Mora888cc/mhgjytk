        local fill2  = MakeFrame(track2, UDim2.new(pct2,0,1,0), UDim2.new(0,0,0,0), ch.color, 32)
        MakeCorner(fill2, 3)
        local thumb2 = MakeFrame(track2, UDim2.new(0,10,0,10), UDim2.new(pct2,0,0.5,-5), Color3.fromRGB(240,240,250), 33)
        MakeCorner(thumb2, 5)
        local valLbl = MakeLabel(popup, math.floor(chValues[ci]*255).."", UDim2.new(0,28,0,16), UDim2.new(1,-36,0,(ci-1)*44+8), PAL.SUBTEXT, 11, 31)
        valLbl.TextXAlignment = Enum.TextXAlignment.Right

        local sl2 = false
        local function Update2(input)
            local ax = track2.AbsolutePosition.X
            local sw = track2.AbsoluteSize.X
            local px = math.clamp((input.Position.X-ax)/sw,0,1)
            chValues[ci]      = px
            fill2.Size        = UDim2.new(px,0,1,0)
            thumb2.Position   = UDim2.new(px,0,0.5,-5)
            valLbl.Text       = math.floor(px*255)..""
            RebuildColor()
        end
        track2.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then sl2=true; Update2(i) end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if sl2 and i.UserInputType == Enum.UserInputType.MouseMovement then Update2(i) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then sl2=false end
        end)
    end

    local swBtn = Instance.new("TextButton")
    swBtn.Size                 = UDim2.new(1,0,1,0)
    swBtn.BackgroundTransparency=1
    swBtn.Text                 = ""
    swBtn.ZIndex               = 9
    swBtn.Parent               = swatch

    swBtn.MouseButton1Click:Connect(function()
        popOpen = not popOpen
        if popOpen then
            local abs = swatch.AbsolutePosition
            local sz  = swatch.AbsoluteSize
            popup.Position = UDim2.new(0, abs.X - 170, 0, abs.Y + sz.Y + 4)
        end
        popup.Visible = popOpen
    end)
    UserInputService.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and popOpen then
            local mpos = UserInputService:GetMouseLocation()
            local abs  = popup.AbsolutePosition
            local sz   = popup.AbsoluteSize
            if mpos.X < abs.X or mpos.X > abs.X+sz.X or mpos.Y < abs.Y or mpos.Y > abs.Y+sz.Y then
                popOpen = false; popup.Visible = false
            end
        end
    end)
    return row
end

