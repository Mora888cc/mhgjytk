-- ══════════════════════════════════════════════════════════════
--  SILENT AIM — TARGET RESOLUTION
-- ══════════════════════════════════════════════════════════════
local function GetTarget()
    local best, bestScore = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if IsTeammate(plr) then continue end
        local char = plr.Character
        if not char then continue end
        local partName = CFG.SA_TargetPart == "Random"
            and ({"Head","UpperTorso","LowerTorso"})[math.random(1,3)]
            or  CFG.SA_TargetPart
        local part = GetCharPart(char, partName)
        if not part then continue end

        local rootPart = char:FindFirstChild("HumanoidRootPart")
        if not rootPart then continue end
        local dist = (Camera.CFrame.Position - rootPart.Position).Magnitude
        if dist > CFG.SA_FOVSize * 5 then continue end

        if CFG.SA_WallCheck and not IsVisibleRay(Camera.CFrame.Position, part.Position) then continue end

        local sp, onScreen = WorldToViewport(part.Position)
        if not onScreen then continue end
        local d2Center = (sp - center).Magnitude
        if d2Center > CFG.SA_FOVSize then continue end

        local _, maxHP = GetHealth(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local score
        if CFG.SA_Target == "Nearest"    then score = d2Center
        elseif CFG.SA_Target == "LowestHP"  then score = hum.Health
        elseif CFG.SA_Target == "HighestHP" then score = -hum.Health
        end

        if score < bestScore then bestScore = score; best = {plr=plr, part=part} end
    end
    return best
end

