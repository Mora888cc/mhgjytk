    MakeLabel(row, label, UDim2.new(1,-50,1,0), UDim2.new(0,10,0,0), PAL.TEXT, 13, 6)

    local track = MakeFrame(row, UDim2.new(0,36,0,18), UDim2.new(1,-44,0.5,-9), CFG[cfgKey] and PAL.TOGGLE_ON or PAL.TOGGLE_OFF, 6)
    MakeCorner(track, 9)
    local knob = MakeFrame(track, UDim2.new(0,14,0,14), UDim2.new(0, CFG[cfgKey] and 19 or 3, 0.5, -7), Color3.fromRGB(240,240,250), 7)
    MakeCorner(knob, 7)

    local btn = Instance.new("TextButton")
    btn.Size                 = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency=1
    btn.Text                 = ""
    btn.ZIndex               = 8
    btn.Parent               = row

    btn.MouseButton1Click:Connect(function()
        CFG[cfgKey] = not CFG[cfgKey]
        local on = CFG[cfgKey]
        TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3 = on and PAL.TOGGLE_ON or PAL.TOGGLE_OFF}):Play()
        TweenService:Create(knob,  TweenInfo.new(0.15), {Position = UDim2.new(0, on and 19 or 3, 0.5, -7)}):Play()
        if callback then callback(on) end
        SaveCFG()
    end)
    return row
end

-- SLIDER
local function AddSlider(page, label, cfgKey, min, max, fmt, callback)
    fmt = fmt or "%.0f"
    local row = Instance.new("Frame")
    row.Size              = UDim2.new(1,-6,0,44)
    row.BackgroundColor3  = PAL.PANEL
    row.BorderSizePixel   = 0
    row.ZIndex            = 5
    row.Parent            = page
    MakeCorner(row, 6)

    local lbl = MakeLabel(row, label, UDim2.new(0.6,0,0,18), UDim2.new(0,10,0,4), PAL.TEXT, 13, 6)
    local val = MakeLabel(row, string.format(fmt, CFG[cfgKey]), UDim2.new(0.35,0,0,18), UDim2.new(0.6,-4,0,4), PAL.SUBTEXT, 12, 6)
    val.TextXAlignment = Enum.TextXAlignment.Right

    local track = MakeFrame(row, UDim2.new(1,-20,0,6), UDim2.new(0,10,0,30), PAL.SLIDER_BG, 6)
    MakeCorner(track, 3)

    local pct = math.clamp((CFG[cfgKey]-min)/(max-min),0,1)
    local fill = MakeFrame(track, UDim2.new(pct,0,1,0), UDim2.new(0,0,0,0), PAL.ACCENT, 7)
    MakeCorner(fill, 3)
    local thumb = MakeFrame(track, UDim2.new(0,12,0,12), UDim2.new(pct,0,0.5,-6), PAL.ACCENT2, 8)
    MakeCorner(thumb, 6)

    local sliding = false
    local function Update(input)
        local abs   = track.AbsolutePosition
        local sz    = track.AbsoluteSize
        local px    = math.clamp((input.Position.X - abs.X)/sz.X, 0, 1)
        local v     = min + (max-min)*px
        CFG[cfgKey] = v
        val.Text    = string.format(fmt, v)
        fill.Size   = UDim2.new(px,0,1,0)
        thumb.Position = UDim2.new(px,0,0.5,-6)
        if callback then callback(v) end
        SaveCFG()
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true; Update(i)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then Update(i) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    return row
end

