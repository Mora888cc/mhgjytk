-- ══════════════════════════════════════════════════════════════
--  MAIN RENDER LOOP
-- ══════════════════════════════════════════════════════════════
local frameCount = 0
RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    local vp    = Camera.ViewportSize
    local center= Vector2.new(vp.X/2, vp.Y/2)

    -- ── FOV Circle ──
    FovCircle.Visible  = CFG.SA_Enabled and CFG.SA_ShowFOV
    FovCircle.Radius   = CFG.SA_FOVSize
    FovCircle.Position = center

    -- ── Crosshair ──
    local chSize = 10
    if CFG.V_Crosshair then
        CH[1].Visible = true; CH[2].Visible = true
        CH[1].Color   = CFG.V_CrosshairColor
        CH[2].Color   = CFG.V_CrosshairColor
        CH[1].From    = Vector2.new(center.X - chSize, center.Y)
        CH[1].To      = Vector2.new(center.X + chSize, center.Y)
        CH[2].From    = Vector2.new(center.X, center.Y - chSize)
        CH[2].To      = Vector2.new(center.X, center.Y + chSize)
    else
        CH[1].Visible = false; CH[2].Visible = false
    end

    -- ── Silent Aim ──
    if CFG.SA_Enabled then
        local t = GetTarget()
        if t then
            if math.random(100) <= CFG.SA_HitChance then
                local sp = WorldToViewport(t.part.Position)
                local smooth = CFG.SA_Smoothness
                -- move mouse toward target smoothly
                pcall(function()
                    mousemoverel(
                        (sp.X - center.X) / smooth,
                        (sp.Y - center.Y) / smooth
                    )
                end)
            end
        end
    end

    -- ── Anti Aim ──
    if CFG.AA_Enabled and frameCount % 2 == 0 then
        pcall(ApplyAntiAim)
    end

    -- ── Time Changer ──
    if CFG.W_TimeChanger then
        pcall(function() Lighting.ClockTime = CFG.W_ClockTime end)
    end

    -- ── Chams (every 10 frames) ──
    if frameCount % 10 == 0 then
        pcall(UpdateChams)
    end

    -- ── ESP ──
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then goto espContinue end
        local cache = GetESPForPlayer(plr)
        local show  = false

        local char = plr.Character
        if char and CFG.ESP_Enabled then
            if not (CFG.ESP_TeamCheck and IsTeammate(plr)) then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (Camera.CFrame.Position - root.Position).Magnitude
                    if dist <= CFG.ESP_MaxDist then
                        local sp, onScreen = WorldToViewport(root.Position)
                        if onScreen then
                            show = true

                            -- Compute bounding box from root
                            local head = char:FindFirstChild("Head")
                            local hPos = head and head.Position or (root.Position + Vector3.new(0,1.5,0))
                            local fPos = root.Position - Vector3.new(0,3,0)

                            local spH, onH = WorldToViewport(hPos)
                            local spF, onF = WorldToViewport(fPos)

                            if onH and onF then
                                local top    = math.min(spH.Y, spF.Y)
                                local bottom = math.max(spH.Y, spF.Y)
                                local height = bottom - top
                                local width  = height * 0.6
                                local left   = sp.X - width/2
                                local right  = sp.X + width/2

                                -- Box: 4 lines
                                if CFG.ESP_Box then
                                    local corners = {
                                        {Vector2.new(left,top),    Vector2.new(right,top)},
                                        {Vector2.new(right,top),   Vector2.new(right,bottom)},
                                        {Vector2.new(right,bottom),Vector2.new(left,bottom)},
                                        {Vector2.new(left,bottom), Vector2.new(left,top)},
                                    }
                                    for i,l in ipairs(cache.box) do
                                        l.Visible = true
                                        l.From    = corners[i][1]
                                        l.To      = corners[i][2]
                                        l.Color   = IsTeammate(plr)
                                            and Color3.fromRGB(60,200,100)
                                            or  Color3.fromRGB(220,60,60)
                                    end
                                else
                                    for _,l in ipairs(cache.box) do l.Visible=false end
                                end

                                -- Name
                                if CFG.ESP_Name then
                                    cache.name.Visible  = true
                                    cache.name.Text     = plr.Name
                                    cache.name.Position = Vector2.new(sp.X, top - 16)
                                else cache.name.Visible = false end

                                -- Health
                                local hp, maxHP = GetHealth(char)
                                if CFG.ESP_Health then
                                    cache.hp.Visible  = true
                                    cache.hp.Text     = math.floor(hp).."/"..math.floor(maxHP)
                                    cache.hp.Position = Vector2.new(left - 4, top)
                                    cache.hp.Color    = Color3.fromRGB(
                                        255 - math.floor((hp/maxHP)*255),
                                        math.floor((hp/maxHP)*255), 60)
                                else cache.hp.Visible = false end

                                -- Distance
                                if CFG.ESP_Distance then
                                    cache.dist.Visible  = true
                                    cache.dist.Text     = math.floor(dist).."m"
                                    cache.dist.Position = Vector2.new(sp.X, bottom + 2)
                                else cache.dist.Visible = false end

                                -- Tracer
                                if CFG.ESP_Tracers then
                                    cache.tracer.Visible = true
                                    cache.tracer.From    = Vector2.new(center.X, vp.Y)
                                    cache.tracer.To      = Vector2.new(sp.X, bottom)
                                    cache.tracer.Color   = Color3.fromRGB(255,255,100)
                                else cache.tracer.Visible = false end

                                -- Skeleton
                                if CFG.ESP_Skeleton then
                                    for bi, bp in ipairs(BONE_PAIRS) do
                                        local pa = char:FindFirstChild(bp[1])
                                        local pb = char:FindFirstChild(bp[2])
                                        if pa and pb then
                                            local sa = WorldToViewport(pa.Position)
                                            local sb = WorldToViewport(pb.Position)
                                            local bone = cache.bones[bi]
                                            if bone then
                                                bone.Visible = true
                                                bone.From    = sa
                                                bone.To      = sb
                                                bone.Color   = Color3.fromRGB(255,200,60)
                                            end
                                        else
                                            if cache.bones[bi] then cache.bones[bi].Visible = false end
                                        end
                                    end
                                else
                                    for _, b in ipairs(cache.bones) do b.Visible = false end
                                end
                            end
                        end
                    end
                end
            end
        end

        if not show then
            for _,l in ipairs(cache.box)   do l.Visible = false end
            for _,l in ipairs(cache.bones) do l.Visible = false end
            cache.name.Visible   = false
            cache.hp.Visible     = false
            cache.dist.Visible   = false
            cache.tracer.Visible = false
        end
        ::espContinue::
    end
end)

