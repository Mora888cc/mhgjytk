local function WorldToViewport(pos)
    local vp, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(vp.X, vp.Y), onScreen, vp.Z
end

local function IsTeammate(plr)
    if not CFG.SA_TeamCheck then return false end
    return plr.Team == LocalPlayer.Team
end

local function IsVisibleRay(origin, target)
    local dir    = (target - origin)
    local ray    = Ray.new(origin, dir)
    local ignore = {LocalPlayer.Character, Camera}
    local hit    = Workspace:FindPartOnRayWithIgnoreList(ray, ignore)
    return hit == nil
end

local function GetCharPart(char, partName)
    return char:FindFirstChild(partName)
end

local function GetHealth(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return 0, 100 end
    return hum.Health, hum.MaxHealth
end

