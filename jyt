                hl.LineThickness   = 0.05
                hl.SurfaceTransparency = CFG.V_Highlight and 0.5 or 1
                hl.SurfaceColor3   = CFG.V_ChamColor
                hl.Adornee         = char
                hl.Parent          = Workspace
                HighlightCache[plr]= hl
            else
                HighlightCache[plr].Color3           = CFG.V_ChamColor
                HighlightCache[plr].SurfaceColor3    = CFG.V_ChamColor
                HighlightCache[plr].SurfaceTransparency = CFG.V_Highlight and 0.5 or 1
            end
        else
            if HighlightCache[plr] then HighlightCache[plr]:Destroy(); HighlightCache[plr]=nil end
        end
    end
end

