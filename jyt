-- Save/Load (pcall-wrapped)
local SAVE_KEY = "NL_CFG_v1"
local function SaveCFG()
    local serial = {}
    for k, v in pairs(CFG) do
        if type(v) == "Color3" then
            serial[k] = {r=v.R, g=v.G, b=v.B}
        elseif type(v) ~= "userdata" then
            serial[k] = v
        end
    end
    pcall(function()
        if syn and syn.protect_gui then return end
        writefile(SAVE_KEY..".json", HttpService:JSONEncode(serial))
    end)
end

local function LoadCFG()
    pcall(function()
        if not isfile(SAVE_KEY..".json") then return end
        local raw = readfile(SAVE_KEY..".json")
        local t   = HttpService:JSONDecode(raw)
        for k, v in pairs(t) do
            if type(v) == "table" and v.r then
                CFG[k] = Color3.new(v.r, v.g, v.b)
            elseif CFG[k] ~= nil then
                CFG[k] = v
            end
        end
    end)
end
LoadCFG()

